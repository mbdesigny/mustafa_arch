---

import { t } from "../i18n/ui";

const locale = Astro.props.locale ?? Astro.params.locale ?? "en";
---

<!-- Footer -->
<footer class="footer-section footer-3 fix section-bg fix">
  <div class="footer-top">
    <div class="container">
      <div class="footer-widget-wrapper-3">
        <div class="row g-3">
          <div class="col-lg-5 col-md-6">
            <div class="single-footer-main-item">
              <div class="footer-logo">
                <a href=""><img src="assets/img/logo/Logo-black.svg" alt="logo-img" /></a>
              </div>
              <p class="mt-3">{t("footer.about")}</p>
              <div class="social-icon mt-4 d-flex align-items-center">
                <a href="#"><i class="fab fa-facebook-f"></i></a>
                <a href="#"><i class="fab fa-twitter"></i></a>
                <a href="#"><i class="fab fa-youtube"></i></a>
                <a href="#"><i class="fab fa-linkedin-in"></i></a>
              </div>
            </div>
          </div>
          <div class="col-lg-2 col-md-6">
            <div class="single-footer-widget">
              <h4>{t("footer.quickLinks")}</h4>
              <ul class="footer-list-2">
                <li><a href="">{t("nav.home")}</a></li>
                <li><a href="about">{t("nav.about")}</a></li>
                <li><a href="service">{t("nav.services")}</a></li>
                <li><a href="portfolio">{t("nav.portfolio")}</a></li>
              </ul>
            </div>
          </div>
          <div class="col-lg-2 col-md-6">
            <div class="single-footer-widget">
              <h4>{t("footer.usefulLinks")}</h4>
              <ul class="footer-list-2">
                <li><a href="faq">{t("nav.faq")}</a></li>
                <li><a href="contact">{t("nav.contact")}</a></li>
                <li><a href="service">{t("nav.services")}</a></li>
                <li><a href="portfolio">{t("nav.portfolio")}</a></li>
              </ul>
            </div>
          </div>
          <div class="col-lg-3 col-md-6">
            <div class="single-footer-main-item">
              <h4 class="mt-md-4">{t("footer.contactInfo")}</h4>
              <div class="footer-contact-item d-flex align-items-center">
                <div class="icon"><i class="fal fa-map-marker-alt"></i></div>
                <div class="text"><span>{t("contact.address")}</span></div>
              </div>
              <div class="footer-contact-item d-flex align-items-center">
                <div class="icon"><i class="fal fa-phone-alt"></i></div>
                <div class="text"><a href="tel:+11002345909">{t("contact.phone")}</a></div>
              </div>
              <div class="footer-contact-item d-flex align-items-center">
                <div class="icon"><i class="fal fa-envelope"></i></div>
                <div class="text"><a href="mailto:info@example.com">info@example.com</a></div>
              </div>
              <div class="footer-contact-item d-flex align-items-center">
                <div class="icon"><i class="fal fa-clock"></i></div>
                <div class="text"><span>{t("footer.workHours")}: {t("contact.hours")}</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom style-3">
    <div class="container">
      <div class="footer-bottom-wrapper d-flex align-items-center justify-content-between">
        <ul class="footer-list">
          <li><a href="">{t("nav.home")}</a></li>
          <li><a href="about">{t("nav.about")}</a></li>
          <li><a href="service">{t("nav.services")}</a></li>
          <li><a href="contact">{t("nav.contact")}</a></li>
        </ul>
        <p>© 2026 Mustafa Arch. {t("footer.rights")}.</p>
      </div>
    </div>
  </div>
</footer>
