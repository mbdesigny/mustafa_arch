---

import { t, allLocales, localeNames } from "../i18n/ui";

const locale = Astro.props.locale ?? Astro.params.locale ?? "en";

const menu = [
  { key: "nav.home", path: "" },
  { key: "nav.about", path: "about" },
  { key: "nav.services", path: "service" },
  { key: "nav.portfolio", path: "portfolio" },
  { key: "nav.faq", path: "faq" },
  { key: "nav.contact", path: "contact" },
];
---

<!-- Offcanvas -->
<div class="fix-area">
  <div class="offcanvas__info">
    <div class="offcanvas__wrapper">
      <div class="offcanvas__content">
        <div class="offcanvas__top mb-5 d-flex justify-content-between align-items-center">
          <div class="offcanvas__logo">
            <a href="">
              <img src="assets/img/logo/Logo-black.svg" alt="logo-img" />
            </a>
          </div>
          <div class="offcanvas__close"><button><i class="fas fa-times"></i></button></div>
        </div>
        <div class="mobile-menu fix mb-3"></div>
        <div class="offcanvas__contact">
          <h4>{t("footer.contactInfo")}</h4>
          <ul>
            <li class="d-flex align-items-center">
              <div class="offcanvas__contact-icon"><i class="fal fa-map-marker-alt"></i></div>
              <div class="offcanvas__contact-text"><a target="_blank" href="#">{t("contact.address")}</a></div>
            </li>
            <li class="d-flex align-items-center">
              <div class="offcanvas__contact-icon mr-15"><i class="fal fa-envelope"></i></div>
              <div class="offcanvas__contact-text"><a href="mailto:info@example.com">info@example.com</a></div>
            </li>
            <li class="d-flex align-items-center">
              <div class="offcanvas__contact-icon mr-15"><i class="fal fa-clock"></i></div>
              <div class="offcanvas__contact-text"><a target="_blank" href="#">{t("contact.hours")}</a></div>
            </li>
            <li class="d-flex align-items-center">
              <div class="offcanvas__contact-icon mr-15"><i class="far fa-phone"></i></div>
              <div class="offcanvas__contact-text"><a href="tel:+11002345909">{t("contact.phone")}</a></div>
            </li>
          </ul>
          <div class="header-button mt-4 text-center">
            <a href="contact" class="theme-btn">{t("nav.letsTalkBtn")} <i class="fa-solid fa-arrow-right"></i></a>
          </div>
          <div class="social-icon d-flex align-items-center">
            <a href="#"><i class="fab fa-facebook-f"></i></a>
            <a href="#"><i class="fab fa-twitter"></i></a>
            <a href="#"><i class="fab fa-youtube"></i></a>
            <a href="#"><i class="fab fa-linkedin-in"></i></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="offcanvas__overlay"></div>

<!-- Header -->
<header class="header-1 header-3" id="header-sticky">
  <div class="container-fluid">
    <div class="mega-menu-wrapper">
      <div class="header-main">
        <div class="logo">
          <a href="" class="header-logo"><img src="assets/img/logo/logo-white.svg" alt="logo-img" /></a>
          <div class="logo-2"><a href=""><img src="assets/img/logo/Logo-black.svg" alt="" /></a></div>
        </div>
        <div class="mean__menu-wrapper">
          <div class="main-menu style-2">
            <nav id="mobile-menu">
              <ul>
                {menu.map((item) => (
                  <li>
                    <a href={item.path}>{t(item.key)}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </div>
        <div class="header-right d-flex justify-content-end align-items-center gap-3">
          <!-- Language switcher -->
          <div class="lang-switcher d-flex align-items-center">
            {allLocales.map((lang) => {
              const active = lang === locale;
              return (
                <a
                  href={lang === "en" ? "" : lang}
                  data-locale={lang}
                  class:list={[{ active }]}
                  style={`font-weight: ${active ? 700 : 400}; opacity: ${active ? 1 : 0.6}; padding: 0 6px; color: inherit;`}
                  aria-label={localeNames[lang][locale]}
                >
                  {lang.toUpperCase()}
                </a>
              );
            })}
          </div>
          <a href="contact" class="theme-btn style-2">
            {t("nav.letsTalk")} <i class="fa-sharp fa-regular fa-arrow-right"></i>
          </a>
          <div class="header__hamburger d-xl-none my-auto">
            <div class="sidebar__toggle style-2"><i class="fas fa-bars"></i></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Language switcher script: redirect to the correct localized URL -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".lang-switcher a[data-locale]").forEach(function (link) {
      link.addEventListener("click", function (e) {
        e.preventDefault();
        var lang = link.getAttribute("data-locale");
        var base = document.querySelector("base") ? document.querySelector("base").getAttribute("href") : "/";
        base = base.replace(/[^/]*$/, ""); /* keep trailing slash */
        var path = window.location.pathname.replace(/^\/(en|fr|ar)/, "");
        if (!path) path = "/";
        var target = base + (lang === "en" ? path.slice(1) : lang + path);
        if (target === window.location.href) return;
        window.location.href = target;
      });
    });
  });
</script>
