---

import Base from "../../layouts/Base.astro";
import { t, setLocale } from "../../i18n/ui";
setLocale(Astro.params.locale ?? "en");

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "fr" } }, { params: { locale: "ar" } }];
}
const locale = Astro.params.locale ?? "en";
---

<Base locale={locale} title={`Mustafa Arch - 404`}>
  <!-- Error Section -->
  <section class="error-section fix" style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
    <div class="container text-center">
      <div class="error-wrapper">
        <div class="error-thumb mb-4">
          <img src="/assets/img/error/404.png" alt="404" />
        </div>
        <div class="error-content">
          <h2 class="wow fadeInUp">{t("error.title")}</h2>
          <p class="mt-3 wow fadeInUp" data-wow-delay=".2s">{t("error.description")}</p>
          <div class="error-btn mt-4 wow fadeInUp" data-wow-delay=".4s">
            <a href="/" class="theme-btn">
              {t("common.backHome")} <i class="fa-solid fa-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
