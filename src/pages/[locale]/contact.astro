---

import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { t, setLocale } from "../../i18n/ui";
setLocale(Astro.params.locale ?? "en");

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "fr" } }, { params: { locale: "ar" } }];
}
const locale = Astro.params.locale ?? "en";
---

<Base locale={locale} title={`Mustafa Arch - ${t("nav.contact")}`}>
  <Breadcrumb locale={locale} titleKey="contact.title" />

  <!-- Contact Info -->
  <section class="contact-section contact-1 section-padding section-bg fix">
    <div class="star-left-shape"></div>
    <div class="star-right-shape"></div>
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-6">
          <div class="contact-wrapper-2">
            <div class="section-title">
              <span class="style-2 border-0 p-0 wow fadeInUp"><img src="/assets/img/shape/star-2.png" alt="img" />{t("contact.title")}</span>
              <h2 class="wow fadeInUp" data-wow-delay=".2s">{t("contact.subtitle")}</h2>
              <p class="mt-3 mt-mb-0">{t("home.features.desc")}</p>
            </div>
            <div class="contact-item-wrapper">
              <div class="contact-item wow fadeInUp" data-wow-delay=".2s">
                <div class="icon"><i class="fa-solid fa-phone"></i></div>
                <div class="content">
                  <span>{t("contact.form.phone")}</span>
                  <h6>{t("contact.phone")}</h6>
                </div>
              </div>
              <div class="contact-item wow fadeInUp" data-wow-delay=".4s">
                <div class="icon"><i class="fa-solid fa-envelope"></i></div>
                <div class="content">
                  <span>Email</span>
                  <h6>info@example.com</h6>
                </div>
              </div>
              <div class="contact-item wow fadeInUp" data-wow-delay=".6s">
                <div class="icon"><i class="fa-solid fa-location-dot"></i></div>
                <div class="content">
                  <span>Address</span>
                  <h6>{t("contact.address")}</h6>
                </div>
              </div>
            </div>
            <div class="social">
              <h6>Social:</h6>
              <ul class="social-list">
                <li class="wow fadeInUp" data-wow-delay=".2s"><a href="#"><i class="fa-brands fa-facebook-f"></i></a></li>
                <li class="wow fadeInUp" data-wow-delay=".4s"><a href="#"><i class="fa-brands fa-twitter"></i></a></li>
                <li class="wow fadeInUp" data-wow-delay=".6s"><a href="#"><i class="fa-brands fa-instagram"></i></a></li>
                <li class="wow fadeInUp" data-wow-delay=".8s"><a href="#"><i class="fa-brands fa-linkedin-in"></i></a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="google-map">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6678.7619084840835!2d144.9618311901502!3d-37.81450084255415!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6ad642b4758afc1d%3A0x3119cc820fdfc62e!2sEnvato!5e0!3m2!1sen!2sbd!4v1641984054261!5m2!1sen!2sbd"
              style="border:0;" allowfullscreen="" loading="lazy">
            </iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="contact-from-section section-bg pt-0 section-padding fix">
    <div class="container">
      <div class="contact-form-box">
        <h3 class="wow fadeInUp">{t("contact.title")}</h3>
        <form method="POST">
          <div class="contact-box">
            <div class="row">
              <div class="col-md-6 wow fadeInUp" data-wow-delay=".2s">
                <input type="text" name="name" placeholder={t("contact.form.name")} />
              </div>
              <div class="col-md-6 wow fadeInUp" data-wow-delay=".5s">
                <input type="tel" name="phone" placeholder={t("contact.form.phone")} />
              </div>
              <div class="col-12 wow fadeInUp" data-wow-delay=".8s">
                <input type="email" name="email" placeholder={t("contact.form.email")} />
              </div>
              <div class="col-12 wow fadeInUp" data-wow-delay="1.1s">
                <textarea name="message" placeholder={t("contact.form.message")}></textarea>
              </div>
              <div class="col-12 wow fadeInUp" data-wow-delay="1.4s">
                <button type="submit" class="theme-btn">
                  {t("contact.form.submit")} <i class="fa-solid fa-arrow-right"></i>
                </button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Footer marquee CTA -->
  <footer class="footer-section fix">
    <div class="bg-shape"><img src="/assets/img/footer/bg-shape.png" alt="img" /></div>
    <div class="mycustom-marque">
      <div class="scrolling-wrap style-2">
        {[1, 2, 3].map(() => (
          <div class="comm">
            <div></div>
            <div class="cmn-textslide">{t("contact.subtitle")}</div>
            <div class="cmn-textslide">TOGETHER</div>
          </div>
        ))}
      </div>
    </div>
    <div class="container">
      <div class="footer-widget-wrapper">
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <div class="footer-item">
              <a href="/" class="footer-logo wow fadeInUp" data-wow-delay=".3s">
                <img src="/assets/img/logo/Logo-black.svg" alt="img" />
              </a>
              <ul class="footer-list-items wow fadeInUp" data-wow-delay=".5s">
                <li><a href="/about">{t("nav.about").toUpperCase()}</a></li>
                <li><a href="/service">{t("nav.services").toUpperCase()}</a></li>
                <li><a href="/portfolio">{t("nav.portfolio").toUpperCase()}</a></li>
                <li><a href="/contact">{t("nav.contact").toUpperCase()}</a></li>
              </ul>
              <ul class="social-icon wow fadeInUp" data-wow-delay=".3s">
                <li><i class="fab fa-facebook-f"></i>Facebook</li>
                <li><i class="fa-brands fa-twitter"></i>Twitter</li>
                <li><i class="fa-brands fa-linkedin-in"></i>Linkedin</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="footer-bottom-wrapper">
          <p class="wow fadeInUp" data-wow-delay=".3s">Copyright © <span>Mustafa Arch</span></p>
          <ul class="footer-list wow fadeInUp" data-wow-delay=".5s">
            <li><a href="/contact">Terms &amp; Conditions</a></li>
            <li><a href="/contact">Privacy Policy</a></li>
          </ul>
        </div>
      </div>
    </div>
  </footer>
</Base>
