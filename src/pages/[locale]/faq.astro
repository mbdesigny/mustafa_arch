---

import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Marquee from "../../components/Marquee.astro";
import { t, setLocale } from "../../i18n/ui";
setLocale(Astro.params.locale ?? "en");

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "fr" } }, { params: { locale: "ar" } }];
}
const locale = Astro.params.locale ?? "en";

const faqs = [
  { key: "faq.q1", aKey: "faq.a1", open: false },
  { key: "faq.q2", aKey: "faq.a2", open: true },
  { key: "faq.q3", aKey: "faq.a3", open: false },
  { key: "faq.q3", aKey: "faq.a1", open: false },
];

const testimonials = [
  { img: "2.jpg", name: "Jakie Chen", role: "Senior Developer" },
  { img: "3.jpg", name: "Michael Sarah", role: "Product Manager" },
  { img: "4.jpg", name: "Jaden Smith", role: "UI Designer" },
];
---

<Base locale={locale} title={`Mustafa Arch - ${t("nav.faq")}`}>
  <Breadcrumb locale={locale} titleKey="faq.title" />

  <!-- FAQs -->
  <section class="faq-section faq-1 section-padding fix section-bg">
    <div class="arrow-shape float-bob-y"><img src="/assets/img/shape/angle-arrow-2.png" alt="img" /></div>
    <div class="star-shape float-bob-x"><img src="/assets/img/shape/star-6.png" alt="img" /></div>
    <div class="container">
      <div class="row">
        <div class="col-xl-5 col-lg-6">
          <div class="section-title">
            <span class="style-2 wow fadeInUp"><img src="/assets/img/shape/star-2.png" alt="img" />{t("faq.subtitle")}</span>
            <h2 class="wow fadeInUp" data-wow-delay=".2s">{t("faq.subtitle")}</h2>
            <p class="wow fadeInUp" data-wow-delay=".3s">
              {t("home.features.desc")}
            </p>
          </div>
          <h6 class="wow fadeInUp" data-wow-delay=".4s">Haven’t found an answer to your query?</h6>
          <a href="/contact" class="theme-btn wow fadeInUp" data-wow-delay=".5s">{t("nav.contact")}</a>
        </div>
        <div class="col-xl-7 col-lg-6">
          <div class="faq-items style-2">
            <div class="faq-accordion">
              <div class="accordion" id="accordion1">
                {faqs.map((f, i) => (
                  <div class="accordion-item mb-3 wow fadeInUp" data-wow-delay={`.${(i + 1) * 2}s`}>
                    <h4 class="accordion-header">
                      <button class:list={["accordion-button", { collapsed: !f.open }]} type="button"
                        data-bs-toggle="collapse" data-bs-target={`#faq${i + 1}`} aria-expanded={f.open}
                        aria-controls={`faq${i + 1}`}>
                        {t(f.key)}
                      </button>
                    </h4>
                    <div id={`faq${i + 1}`} class:list={["accordion-collapse", "collapse", { show: f.open }]} data-bs-parent="#accordion1">
                      <div class="accordion-body">{t(f.aKey)}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Marquee text={t("about.study.eyebrow")} />

  <!-- Testimonials -->
  <section class="testimonials-section testimonials-2 section-padding fix">
    <div class="container">
      <div class="section-title-area">
        <div class="section-title">
          <span class="style-2 wow fadeInUp"><img src="/assets/img/shape/star-2.png" alt="img" />{t("home.testimonials.eyebrow")}</span>
          <h2 class="wow fadeInUp" data-wow-delay=".2s">{t("faq.testimonials.title")}</h2>
        </div>
        <div class="slide-btn">
          <button class="array-prev"><i class="fa-solid fa-arrow-left"></i></button>
          <button class="array-next"><i class="fa-solid fa-arrow-right"></i></button>
        </div>
      </div>
      <div class="swiper testi-content-slider mxg">
        <div class="swiper-wrapper">
          {testimonials.map((tm, i) => (
            <div class="swiper-slide">
              <div class:list={["testimonials-item", { "style-2": i === 0 }]}>
                <div class="head">
                  <div class="info">
                    <div class="thumb"><img src={`/assets/img/testimonials/${tm.img}`} alt="img" /></div>
                    <div class="text">
                      <h4>{tm.name}</h4>
                      <span>{tm.role}</span>
                    </div>
                  </div>
                  <div class="qoute"><img src="/assets/img/icon/24.svg" alt="img" /></div>
                </div>
                <p>{t("home.testimonials.quote")}</p>
                <div class="star">
                  <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                  <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
