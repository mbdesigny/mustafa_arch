---

import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Marquee from "../../components/Marquee.astro";
import { t, setLocale } from "../../i18n/ui";
setLocale(Astro.params.locale ?? "en");

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "fr" } }, { params: { locale: "ar" } }];
}
const locale = Astro.params.locale ?? "en";
---

<Base locale={locale} title={`Mustafa Arch - ${t("portfolioDetails.title")}`}>
  <Breadcrumb locale={locale} titleKey="portfolioDetails.title" />
  <Marquee text={t("portfolioDetails.eyebrow")} />

  <section class="portfolio-details-section section-padding section-bg fix">
    <div class="container">
      <div class="portfolio-details-wrapper">
        <div class="row g-4">
          <div class="col-lg-8">
            <div class="portfolio-details-thumb">
              <img src="assets/img/project/01.png" alt="img" class="wow fadeInUp" />
            </div>
            <div class="portfolio-details-content mt-4">
              <h3 class="wow fadeInUp" data-wow-delay=".2s">{t("portfolioDetails.problem.title")}</h3>
              <p class="mt-3 wow fadeInUp" data-wow-delay=".3s">{t("home.features.desc")}</p>
              <h3 class="mt-4 wow fadeInUp" data-wow-delay=".4s">{t("portfolioDetails.research.title")}</h3>
              <p class="mt-3 wow fadeInUp" data-wow-delay=".5s">{t("home.features.desc")}</p>
              <h3 class="mt-4 wow fadeInUp" data-wow-delay=".6s">{t("portfolioDetails.outcome.title")}</h3>
              <p class="mt-3 wow fadeInUp" data-wow-delay=".7s">{t("home.features.desc")}</p>
            </div>
          </div>
          <div class="col-lg-4">
            <div class="portfolio-info-box wow fadeInUp" data-wow-delay=".3s">
              <h4>{t("portfolioDetails.info.title")}</h4>
              <ul class="portfolio-info-list">
                <li><span>Client:</span> Mustafa Arch</li>
                <li><span>Category:</span> {t("home.service3.title")}</li>
                <li><span>Date:</span> 2024</li>
                <li><span>Website:</span> mustafa-arch.com</li>
              </ul>
              <a href="contact" class="theme-btn mt-3">
                {t("portfolioDetails.title")} <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
