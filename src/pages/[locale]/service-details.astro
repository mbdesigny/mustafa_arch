---

import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Marquee from "../../components/Marquee.astro";
import { t, setLocale } from "../../i18n/ui";
setLocale(Astro.params.locale ?? "en");

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "fr" } }, { params: { locale: "ar" } }];
}
const locale = Astro.params.locale ?? "en";
---

<Base locale={locale} title={`Mustafa Arch - ${t("serviceDetails.title")}`}>
  <Breadcrumb locale={locale} titleKey="serviceDetails.title" />
  <Marquee text={t("about.study.eyebrow")} />

  <section class="service-details-section section-padding section-bg fix">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-8">
          <div class="service-details-content">
            <h3 class="wow fadeInUp" data-wow-delay=".2s">{t("serviceDetails.process.titleWeb")}</h3>
            <p class="mt-3 wow fadeInUp" data-wow-delay=".3s">{t("home.features.desc")}</p>
            <div class="service-process mt-4">
              <h4>{t("serviceDetails.process.title")}</h4>
              <ul class="list mt-3">
                <li><i class="fa-solid fa-circle-chevron-right"></i>{t("home.exp1.li1")}</li>
                <li><i class="fa-solid fa-circle-chevron-right"></i>{t("home.exp1.li2")}</li>
                <li><i class="fa-solid fa-circle-chevron-right"></i>{t("home.exp2.li1")}</li>
              </ul>
            </div>
            <div class="service-why mt-4">
              <h4>{t("serviceDetails.why.title")}</h4>
              <p class="mt-3">{t("home.features.desc")}</p>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="service-sidebar">
            <div class="service-list-box wow fadeInUp" data-wow-delay=".3s">
              <h4>{t("serviceDetails.category")}</h4>
              <ul class="service-list">
                <li><a href="/service">{t("home.service1.title")}</a></li>
                <li><a href="/service">{t("home.service2.title")}</a></li>
                <li><a href="/service">{t("home.service3.title")}</a></li>
              </ul>
            </div>
            <div class="service-contact-box mt-4 wow fadeInUp" data-wow-delay=".5s">
              <h4>{t("serviceDetails.contact.title")}</h4>
              <a href="/contact" class="theme-btn mt-3">
                {t("nav.contact")} <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
