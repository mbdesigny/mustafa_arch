---

import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Marquee from "../../components/Marquee.astro";
import { t, setLocale } from "../../i18n/ui";
setLocale(Astro.params.locale ?? "en");

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "fr" } }, { params: { locale: "ar" } }];
}
const locale = Astro.params.locale ?? "en";
---

<Base locale={locale} title={`Mustafa Arch - ${t("nav.services")}`}>
  <Breadcrumb locale={locale} titleKey="service.title" />
  <Marquee text={t("about.study.eyebrow")} />

  <!-- Services -->
  <section class="service-section service-1 section-padding section-bg fix">
    <div class="random-shape float-bob-y"><img src="assets/img/shape/random-shape.png" alt="img" /></div>
    <div class="container">
      <h2 class="sub-title">{t("home.services.eyebrow").toUpperCase()}</h2>
      <div class="section-title text-center">
        <span class="wow fadeInUp"><img src="assets/img/shape/star-2.png" alt="img" />{t("home.services.eyebrow")}<img src="assets/img/shape/star-2.png" alt="img" /></span>
        <h2 class="wow fadeInUp" data-wow-delay=".2s">{t("home.services.title")}</h2>
      </div>
      <div class="service-wrapper">
        {[1, 2, 3, 4].map((n) => (
          <div class="services-item wow fadeInUp" data-wow-delay={`.${n * 2}s`}>
            <div class="head">
              <span>0{n}</span>
              <h4><a href="service">{t(`home.service${Math.min(n, 3)}.title`)}</a></h4>
            </div>
            <div class="text">
              <p>{t("home.features.desc")}</p>
            </div>
            <div class="link-btn">
              <i class="fa-solid fa-arrow-right"></i>
              <a href="service">{t("common.readMore")}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Awards -->
  <section class="awards-section section-padding fix">
    <div class="trophy-shape"><img src="assets/img/shape/trophy.png" alt="img" /></div>
    <div class="star-shape float-bob-x"><img src="assets/img/shape/star.png" alt="img" /></div>
    <div class="container">
      <div class="awards-wrapper">
        <div class="row g-4">
          <div class="col-md-6">
            <div class="section-title mb-0">
              <span class="wow fadeInUp"><img src="assets/img/shape/star-2.png" alt="img" />{t("service.awards.title")}</span>
              <h2 class="wow fadeInUp" data-wow-delay=".2s"><span>{t("service.awards.title")}</span> & Recognition</h2>
            </div>
          </div>
          {[1, 2, 3, 4].map((n, i) => (
            <div class="col-md-6">
              <div class="awards-item wow fadeInUp" data-wow-delay={`.${(i + 1) * 3}s`}>
                <div class="content">
                  <div class="icon"><img src={`assets/img/icon/${n}.svg`} alt="img" /></div>
                  <div class="text">
                    <h4>{t(`service.award${i + 1}`)}</h4>
                    <span>March 26, 2024</span>
                  </div>
                </div>
                <div class="icon"><img src={`assets/img/icon/${4 + n}.svg`} alt="img" /></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing-section section-padding section-bg fix">
    <div class="container">
      <div class="section-title text-center">
        <span><img src="assets/img/shape/star-2.png" alt="img" />{t("service.awards.title")}</span>
        <h2>{t("service.plan.basic").split(" ")[0]} <span>{t("service.awards.title")}</span> {t("service.plan.basic").split(" ").pop()}</h2>
      </div>
      <div class="price-wrapper">
        <div class="row">
          {["basic", "standard", "premium"].map((plan, i) => (
            <div class="col-lg-4 col-md-6">
              <div class:list={["price-item", { "style-2": plan === "standard" }]}>
                <div class="content">
                  {plan === "standard" && <h6 class="box">Most Popular</h6>}
                  <h4>{t(`service.plan.${plan}`)}</h4>
                  <h3>{t(`service.price${i + 1}`)}<span>/Monthly</span></h3>
                  <p>{t("home.features.desc")}</p>
                </div>
                <ul class="price-list">
                  <li><i class="fa-solid fa-circle-chevron-right"></i>{t("home.service3.title")}</li>
                  <li><i class="fa-solid fa-circle-chevron-right"></i>Design Customization</li>
                  <li><i class="fa-solid fa-circle-chevron-right"></i>Design with Figma</li>
                  <li><i class="fa-solid fa-circle-chevron-right"></i>Multipage Design</li>
                  <li><i class="fa-solid fa-circle-chevron-right"></i>Support 6 months</li>
                </ul>
                <a href="contact" class="theme-btn">
                  {t("common.hireMe")} <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Footer marquee CTA -->
  <footer class="footer-section fix">
    <div class="bg-shape"><img src="assets/img/footer/bg-shape.png" alt="img" /></div>
    <div class="mycustom-marque">
      <div class="scrolling-wrap style-2">
        {[1, 2, 3].map(() => (
          <div class="comm">
            <div></div>
            <div class="cmn-textslide">{t("contact.subtitle")}</div>
            <div class="cmn-textslide">TOGETHER</div>
          </div>
        ))}
      </div>
    </div>
    <div class="container">
      <div class="footer-widget-wrapper">
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <div class="footer-item">
              <a href="" class="footer-logo wow fadeInUp" data-wow-delay=".3s">
                <img src="assets/img/logo/Logo-black.svg" alt="img" />
              </a>
              <ul class="footer-list-items wow fadeInUp" data-wow-delay=".5s">
                <li><a href="">{t("nav.home")}</a></li>
                <li><a href="about">{t("nav.about")}</a></li>
                <li><a href="service">{t("nav.services")}</a></li>
                <li><a href="portfolio">{t("nav.portfolio")}</a></li>
                <li><a href="faq">{t("nav.faq")}</a></li>
                <li><a href="contact">{t("nav.contact")}</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </footer>
</Base>
